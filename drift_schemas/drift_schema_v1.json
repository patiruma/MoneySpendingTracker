    {
      "name": "labels",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"labels\" (\"id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"parent_id\" TEXT NULL REFERENCES labels (id), \"depth\" INTEGER NOT NULL, \"is_placeholder\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_placeholder\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"), CHECK (depth BETWEEN 0 AND 2), CHECK (length(trim(name)) > 0));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" TEXT NOT NULL, \"amount_cents\" INTEGER NOT NULL, \"occurred_at\" INTEGER NOT NULL, \"category_id\" TEXT NOT NULL REFERENCES labels (id), \"payment_method_id\" TEXT NOT NULL REFERENCES labels (id), \"note\" TEXT NOT NULL, \"extra_notes\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"), CHECK (amount_cents > 0), CHECK (length(trim(note)) > 0));"
        }
      ]
